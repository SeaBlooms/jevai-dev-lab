# Copy to .env and fill in. Do not commit .env.
# Set AI_GATEWAY_API_KEY by hand (Vercel AI Gateway). This process does not read other projects' env files.

AI_GATEWAY_API_KEY=
JEV_MODEL=anthropic/claude-sonnet-5
JEV_API_TOKEN=dev-local-token
JEV_HOST=127.0.0.1
JEV_PORT=8790

# Default backend when a request or case does not pick one: gateway | ollama
JEV_BACKEND=gateway

# Ollama (OpenAI-compatible; include /v1). No key needed.
# For a box on your LAN, use its address, e.g. http://<lan-host>:11434/v1
# Inside Docker with Ollama on the host: http://host.docker.internal:11434/v1 (the image default)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
# Seconds; covers a cold model load on the first request after unload.
OLLAMA_TIMEOUT=300
